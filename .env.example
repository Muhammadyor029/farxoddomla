# GEMINI_API_KEY: Required for server-side Gemini AI legal tutor calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret used to sign authentication tokens on the server.
JWT_SECRET="change-me-in-production-huquq-olami-secret"

# SQLITE_PATH: Local relational database file path for Node server.
SQLITE_PATH="./data/huquq_olami.db"

# APP_URL: Hosted application URL injected at runtime.
APP_URL="MY_APP_URL"
