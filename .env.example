# === OPTIONAL ADMIN CREDENTIALS ===
# OWNER_LOGIN / OWNER_PASSWORD: Initial administrator account credentials (password min 8 chars).
# Built-in default when unset: login "qonun", password "qonun1991".
# Env vars take precedence and override the built-in default on first boot only.
# Bootstrapped once if no admin exists yet; never overwritten on subsequent restarts.
# Set these in production instead of relying on the built-in default.
OWNER_LOGIN=""
OWNER_PASSWORD=""

# === OPTIONAL (Auto-configured with sensible defaults in code) ===
# GEMINI_API_KEY: Only required if enabling AI Ustoz (/api/ai/task).
GEMINI_API_KEY=""

# JWT_SECRET: Optional in single-instance AI Studio (auto-persisted to ./data/.jwt_secret).
# Set a 32+ char secret in multi-instance production so tokens persist across rebuilds.
JWT_SECRET=""

# SQLITE_PATH: Built-in default is "./data/huquq_olami.db".
SQLITE_PATH="./data/huquq_olami.db"

# CORS_ORIGIN: Optional extra origins (same-host, localhost, and AI Studio APP_URL are auto-allowed).
CORS_ORIGIN=""

# TRUST_PROXY: Enabled by default (1) for Cloud Run / AI Studio; set "false" to disable.
TRUST_PROXY="true"

# AUTH_RATE_LIMIT_MAX / AI_RATE_LIMIT_MAX: Built-in defaults are 12 auth/min and 25 AI/min.
AUTH_RATE_LIMIT_MAX="12"
AI_RATE_LIMIT_MAX="25"

# VITE_API_BASE_URL: Built-in default is "" (same-origin relative /api/* requests).
VITE_API_BASE_URL=""
